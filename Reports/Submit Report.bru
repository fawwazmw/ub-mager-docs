meta {
  name: Submit Report
  type: http
  seq: 1
}

post {
  url: {{base_url}}/reports
  body: json
  auth: inherit
}

body:json {
  {
    "reported_user_id": "{{reported_user_id}}",
    "ride_id": "{{ride_id}}",
    "category": "RUDE_BEHAVIOR",
    "description": "Driver was rude and drove recklessly during the trip"
  }
}
