meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "phone": "+6280000000000",
    "password": "Password123!"
  }
}

script:post-response {
  if (res.body.success) {
    bru.setVar("access_token", res.body.data.access_token);
    bru.setEnvVar("access_token", res.body.data.access_token);
  }
}
